#!/system/bin/sh

. "$(dirname "$(realpath "$0")")/box.env"

MODULE_DESC_BASE="Use mihomo on Android devices."

update_module_prop_description() {
    local prop_file="$1"
    local new_description="$2"
    local tmp_file

    [ -f "${prop_file}" ] || return 0

    tmp_file="${prop_file}.tmp.$$"
    awk -v desc="${new_description}" '
        BEGIN { updated = 0 }
        /^description=/ { print "description=" desc; updated = 1; next }
        { print }
        END {
            if (!updated) {
                print "description=" desc
            }
        }
    ' "${prop_file}" > "${tmp_file}" || {
        rm -f "${tmp_file}" > /dev/null 2>&1
        return 1
    }

    mv -f "${tmp_file}" "${prop_file}" || {
        rm -f "${tmp_file}" > /dev/null 2>&1
        return 1
    }
}

update_module_status() {
    local state="$1"
    local state_text

    case "${state}" in
        running)
            state_text="Running"
            ;;
        stopped)
            state_text="Stopped"
            ;;
        starting)
            state_text="Starting"
            ;;
        error)
            state_text="Error"
            ;;
        *)
            state_text="Unknown"
            ;;
    esac

    local status_desc="${MODULE_DESC_BASE} [${state_text}]"
    update_module_prop_description "${module_dir}/module.prop" "${status_desc}"
}

log() {
    local level="$1"
    local message="$2"
    local timestamp

    export TZ=Asia/Shanghai
    timestamp="$(date +"%Y-%m-%d %H:%M:%S")"
    printf "%s [%s]: %s\n" "${timestamp}" "${level}" "${message}" >&2
}

resolve_user_group() {
    case "${CORE_USER_GROUP}" in
        *:*)
            core_user="${CORE_USER_GROUP%%:*}"
            core_group="${CORE_USER_GROUP#*:}"
            ;;
        *)
            core_user="root"
            core_group="net_admin"
            ;;
    esac

    [ -n "${core_user}" ] || core_user="root"
    [ -n "${core_group}" ] || core_group="net_admin"

    if ! id -u "${core_user}" > /dev/null 2>&1 || ! id -g "${core_group}" > /dev/null 2>&1; then
        core_user="root"
        core_group="net_admin"
    fi

    core_user_group="${core_user}:${core_group}"
}

ensure_binary() {
    if command -v "${bin_name}" > /dev/null 2>&1 && command -v "${bin_name}" | grep -q "^/system/bin/"; then
        bin_path="$(command -v "${bin_name}")"
    fi

    if [ ! -f "${bin_path}" ]; then
        log Error "missing ${bin_name} core, please place it in ${box_path}/bin/"
        return 1
    fi

    return 0
}

prepare_permission() {
    resolve_user_group
    chown "${core_user_group}" "${bin_path}" > /dev/null 2>&1 || true
    chmod 0700 "${bin_path}" > /dev/null 2>&1 || true
    chown -R "${core_user_group}" "${box_path}" > /dev/null 2>&1 || true
}

check_config() {
    if "${bin_path}" -t -d "${box_path}/${bin_name}" > "${run_path}/check.log" 2>&1; then
        return 0
    fi

    log Error "configuration check failed, see ${run_path}/check.log"
    return 1
}

running_pid() {
    if [ -f "${pid_file}" ]; then
        pid="$(cat "${pid_file}" 2> /dev/null)"
        if [ -n "${pid}" ] && kill -0 "${pid}" > /dev/null 2>&1; then
            echo "${pid}"
            return 0
        fi
    fi

    pid="$(busybox pidof "${bin_name}" 2> /dev/null | awk '{print $1}')"
    if [ -z "${pid}" ]; then
        pid="$(pidof "${bin_name}" 2> /dev/null | awk '{print $1}')"
    fi
    if [ -n "${pid}" ]; then
        echo "${pid}"
        return 0
    fi

    return 1
}

start_service() {
    if pid="$(running_pid)"; then
        echo -n "${pid}" > "${pid_file}"
        log Info "${bin_name} is already running. ( PID: ${pid} )"
        update_module_status running
        return 0
    fi

    update_module_status starting

    mkdir -p "${run_path}" "${box_path}/${bin_name}"
    ensure_binary || {
        update_module_status error
        return 1
    }
    prepare_permission
    check_config || {
        update_module_status error
        return 1
    }

    log Info "starting ${bin_name} service."

    if command -v busybox > /dev/null 2>&1; then
        nohup busybox setuidgid "${core_user_group}" "${bin_path}" -d "${box_path}/${bin_name}" > "${box_path}/${bin_name}/${bin_name}_$(date +%Y%m%d%H%M).log" 2> "${run_path}/error_${bin_name}.log" &
    else
        nohup "${bin_path}" -d "${box_path}/${bin_name}" > "${box_path}/${bin_name}/${bin_name}_$(date +%Y%m%d%H%M).log" 2> "${run_path}/error_${bin_name}.log" &
    fi

    sleep 1

    if pid="$(running_pid)"; then
        echo -n "${pid}" > "${pid_file}"
        log Info "${bin_name} started. ( PID: ${pid} )"
        update_module_status running
        return 0
    fi

    rm -f "${pid_file}" > /dev/null 2>&1
    log Error "start ${bin_name} failed, see ${run_path}/error_${bin_name}.log"
    update_module_status error
    return 1
}

stop_service() {
    if pid="$(running_pid)"; then
        log Warn "stopping ${bin_name} service."
        kill "${pid}" > /dev/null 2>&1 || killall "${bin_name}" > /dev/null 2>&1 || true
        sleep 1
    fi

    if pid="$(running_pid)"; then
        log Warn "${bin_name} is still running. ( PID: ${pid} )"
        update_module_status running
        return 1
    fi

    rm -f "${pid_file}" > /dev/null 2>&1
    log Info "${bin_name} stopped."
    update_module_status stopped
    return 0
}

status_service() {
    if pid="$(running_pid)"; then
        echo -n "${pid}" > "${pid_file}"
        log Info "${bin_name} is running. ( PID: ${pid} )"
        update_module_status running
        return 0
    fi

    rm -f "${pid_file}" > /dev/null 2>&1
    log Warn "${bin_name} is stopped."
    update_module_status stopped
    return 1
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service
        sleep 1
        start_service
        ;;
    status)
        status_service
        ;;
    *)
        log Error "$0 $1 usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
