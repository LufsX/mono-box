#!/system/bin/sh

. "$(dirname "$(realpath "$0")")/box.env"

MODULE_DESC_BASE="Use mihomo on Android devices."

update_module_prop_description() {
    local prop_file="$1"
    local new_description="$2"
    local tmp_file

    [ -f "${prop_file}" ] || return 0

    tmp_file="${prop_file}.tmp.$$"
    awk -v desc="${new_description}" '
        BEGIN { updated = 0 }
        /^description=/ { print "description=" desc; updated = 1; next }
        { print }
        END {
            if (!updated) {
                print "description=" desc
            }
        }
    ' "${prop_file}" > "${tmp_file}" || {
        rm -f "${tmp_file}" > /dev/null 2>&1
        return 1
    }

    mv -f "${tmp_file}" "${prop_file}" || {
        rm -f "${tmp_file}" > /dev/null 2>&1
        return 1
    }
}

update_module_status() {
    local state="$1"
    local state_text

    case "${state}" in
        running)
            state_text="Running"
            ;;
        stopped)
            state_text="Stopped"
            ;;
        starting)
            state_text="Starting"
            ;;
        error)
            state_text="Error"
            ;;
        *)
            state_text="Unknown"
            ;;
    esac

    local status_desc="${MODULE_DESC_BASE} [${state_text}]"
    update_module_prop_description "${module_dir}/module.prop" "${status_desc}"
}

log() {
    local level="$1"
    local message="$2"
    local timestamp

    export TZ=Asia/Shanghai
    timestamp="$(date +"%Y-%m-%d %H:%M:%S")"
    printf "%s [%s]: %s\n" "${timestamp}" "${level}" "${message}" >&2
}

resolve_user_group() {
    case "${CORE_USER_GROUP}" in
        *:*)
            core_user="${CORE_USER_GROUP%%:*}"
            core_group="${CORE_USER_GROUP#*:}"
            ;;
        *)
            core_user="root"
            core_group="net_admin"
            ;;
    esac

    [ -n "${core_user}" ] || core_user="root"
    [ -n "${core_group}" ] || core_group="net_admin"

    if ! id -u "${core_user}" > /dev/null 2>&1 || ! id -g "${core_group}" > /dev/null 2>&1; then
        core_user="root"
        core_group="net_admin"
    fi

    core_user_group="${core_user}:${core_group}"
}

ensure_binary() {
    if command -v "${bin_name}" > /dev/null 2>&1 && command -v "${bin_name}" | grep -q "^/system/bin/"; then
        bin_path="$(command -v "${bin_name}")"
    fi

    if [ ! -f "${bin_path}" ]; then
        log Error "missing ${bin_name} core, please place it in ${box_path}/bin/"
        return 1
    fi

    return 0
}

prepare_permission() {
    resolve_user_group
    chown "${core_user_group}" "${bin_path}" > /dev/null 2>&1 || true
    chmod 0700 "${bin_path}" > /dev/null 2>&1 || true
    chown -R "${core_user_group}" "${box_path}" > /dev/null 2>&1 || true
}

active_config_file() {
    local active_file="${box_path}/${bin_name}/.mono-box/active-profile"
    local profile_dir="${box_path}/${bin_name}/.mono-box/profiles"
    local active_name=""
    local profile_file

    if [ -f "${active_file}" ]; then
        active_name="$(cat "${active_file}" 2> /dev/null)"
    fi

    case "${active_name}" in
        "" | *"/"* | *".."*)
            active_name=""
            ;;
    esac

    if [ -n "${active_name}" ]; then
        profile_file="${profile_dir}/${active_name}"
        if [ -f "${profile_file}" ]; then
            printf "%s" "${profile_file}"
            return 0
        fi
    fi

    printf "%s" "${box_path}/${bin_name}/config.yaml"
}

check_config() {
    local config_file
    local default_config="${box_path}/${bin_name}/config.yaml"
    local config_args="-d ${box_path}/${bin_name}"

    config_file="$(active_config_file)"
    if [ ! -f "${config_file}" ]; then
        log Error "missing configuration file: ${config_file}"
        return 1
    fi

    # Default config lives under the -d directory as config.yaml; omit -f so
    # mihomo reads it natively. Only pass -f for switched profiles.
    [ "${config_file}" = "${default_config}" ] || config_args="${config_args} -f ${config_file}"

    if "${bin_path}" -t ${config_args} > "${run_path}/check.log" 2>&1; then
        return 0
    fi

    log Error "configuration check failed, see ${run_path}/check.log"
    return 1
}

running_pid() {
    if [ -f "${pid_file}" ]; then
        pid="$(cat "${pid_file}" 2> /dev/null)"
        if [ -n "${pid}" ] && kill -0 "${pid}" > /dev/null 2>&1; then
            echo "${pid}"
            return 0
        fi
    fi

    pid="$(busybox pidof "${bin_name}" 2> /dev/null | awk '{print $1}')"
    if [ -z "${pid}" ]; then
        pid="$(pidof "${bin_name}" 2> /dev/null | awk '{print $1}')"
    fi
    if [ -n "${pid}" ]; then
        echo "${pid}"
        return 0
    fi

    return 1
}

start_service() {
    local config_file
    local default_config="${box_path}/${bin_name}/config.yaml"
    local config_args

    if pid="$(running_pid)"; then
        echo -n "${pid}" > "${pid_file}"
        log Info "${bin_name} is already running. ( PID: ${pid} )"
        update_module_status running
        return 0
    fi

    update_module_status starting

    mkdir -p "${run_path}" "${box_path}/${bin_name}"
    ensure_binary || {
        update_module_status error
        return 1
    }
    prepare_permission
    check_config || {
        update_module_status error
        return 1
    }

    config_file="$(active_config_file)"
    log Info "starting ${bin_name} service."

    # Default config lives under the -d directory as config.yaml; omit -f so
    # mihomo reads it natively. Only pass -f for switched profiles.
    if [ "${config_file}" = "${default_config}" ]; then
        config_args="-d ${box_path}/${bin_name}"
    else
        config_args="-d ${box_path}/${bin_name} -f ${config_file}"
    fi

    if command -v busybox > /dev/null 2>&1; then
        nohup busybox setuidgid "${core_user_group}" "${bin_path}" ${config_args} > "${box_path}/${bin_name}/${bin_name}_$(date +%Y%m%d%H%M).log" 2> "${run_path}/error_${bin_name}.log" &
    else
        nohup "${bin_path}" ${config_args} > "${box_path}/${bin_name}/${bin_name}_$(date +%Y%m%d%H%M).log" 2> "${run_path}/error_${bin_name}.log" &
    fi

    sleep 1

    if pid="$(running_pid)"; then
        echo -n "${pid}" > "${pid_file}"
        log Info "${bin_name} started. ( PID: ${pid} )"
        update_module_status running
        return 0
    fi

    rm -f "${pid_file}" > /dev/null 2>&1
    log Error "start ${bin_name} failed, see ${run_path}/error_${bin_name}.log"
    update_module_status error
    return 1
}

stop_service() {
    if pid="$(running_pid)"; then
        log Warn "stopping ${bin_name} service."
        kill "${pid}" > /dev/null 2>&1 || killall "${bin_name}" > /dev/null 2>&1 || true
        sleep 1
    fi

    if pid="$(running_pid)"; then
        log Warn "${bin_name} is still running. ( PID: ${pid} )"
        update_module_status running
        return 1
    fi

    rm -f "${pid_file}" > /dev/null 2>&1
    log Info "${bin_name} stopped."
    update_module_status stopped
    return 0
}

status_service() {
    if pid="$(running_pid)"; then
        echo -n "${pid}" > "${pid_file}"
        log Info "${bin_name} is running. ( PID: ${pid} )"
        update_module_status running
        return 0
    fi

    rm -f "${pid_file}" > /dev/null 2>&1
    log Warn "${bin_name} is stopped."
    update_module_status stopped
    return 1
}

list_log_files() {
    local core_log_dir="${box_path}/${bin_name}"

    [ -d "${core_log_dir}" ] || return 0
    find "${core_log_dir}" -type f -name "${bin_name}_*.log" 2> /dev/null
}

log_file_size() {
    local file="$1"
    local size

    size="$(wc -c < "${file}" 2> /dev/null | tr -d '[:space:]')"
    case "${size}" in
        "" | *[!0-9]*)
            size=0
            ;;
    esac

    printf "%s" "${size}"
}

active_log_file() {
    local pid="$1"
    local fd_log=""

    [ -n "${pid}" ] || return 1

    if command -v readlink > /dev/null 2>&1; then
        fd_log="$(readlink "/proc/${pid}/fd/1" 2> /dev/null)"
    fi

    if [ -z "${fd_log}" ] && command -v busybox > /dev/null 2>&1; then
        fd_log="$(busybox readlink "/proc/${pid}/fd/1" 2> /dev/null)"
    fi

    fd_log="${fd_log% (deleted)}"
    case "${fd_log}" in
        "${box_path}/${bin_name}/${bin_name}_"*.log)
            [ -f "${fd_log}" ] || return 1
            printf "%s" "${fd_log}"
            return 0
            ;;
    esac

    return 1
}

latest_listed_log_file() {
    local list_file="$1"

    [ -s "${list_file}" ] || return 1

    if command -v sort > /dev/null 2>&1 && command -v tail > /dev/null 2>&1; then
        sort "${list_file}" 2> /dev/null | tail -n 1
        return 0
    fi

    if command -v busybox > /dev/null 2>&1; then
        busybox sort "${list_file}" 2> /dev/null | busybox tail -n 1
        return 0
    fi

    return 1
}

logs_size_service() {
    local tmp_file
    local file
    local size
    local total=0
    local count=0

    mkdir -p "${run_path}"
    tmp_file="${run_path}/.logs_size.$$"
    list_log_files > "${tmp_file}" 2> /dev/null || true

    while IFS= read -r file; do
        [ -f "${file}" ] || continue
        size="$(log_file_size "${file}")"
        total=$((total + size))
        count=$((count + 1))
        printf "file\t%s\t%s\n" "${size}" "${file}"
    done < "${tmp_file}"

    printf "total\t%s\t%s\n" "${total}" "${count}"
    rm -f "${tmp_file}" > /dev/null 2>&1
}

clear_logs_service() {
    local tmp_file
    local file
    local size
    local pid
    local active_log=""
    local total=0
    local count=0
    local failed=0
    local skipped=0

    mkdir -p "${run_path}"
    tmp_file="${run_path}/.clear_logs.$$"
    list_log_files > "${tmp_file}" 2> /dev/null || true

    if pid="$(running_pid)"; then
        active_log="$(active_log_file "${pid}")"
        [ -n "${active_log}" ] || active_log="$(latest_listed_log_file "${tmp_file}")"
    fi

    while IFS= read -r file; do
        [ -f "${file}" ] || continue
        size="$(log_file_size "${file}")"

        if [ -n "${active_log}" ] && [ "${file}" = "${active_log}" ]; then
            skipped=$((skipped + 1))
            printf "file\tskipped\t%s\t%s\n" "${size}" "${file}"
            continue
        fi

        if rm -f "${file}" 2> /dev/null; then
            total=$((total + size))
            count=$((count + 1))
            printf "file\tcleared\t%s\t%s\n" "${size}" "${file}"
        else
            failed=$((failed + 1))
            printf "file\tfailed\t%s\t%s\n" "${size}" "${file}"
        fi
    done < "${tmp_file}"

    printf "cleared\t%s\t%s\t%s\t%s\n" "${total}" "${count}" "${failed}" "${skipped}"
    rm -f "${tmp_file}" > /dev/null 2>&1

    [ "${failed}" -eq 0 ]
}

case "$1" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        stop_service
        sleep 1
        start_service
        ;;
    status)
        status_service
        ;;
    logs_size | log_size)
        logs_size_service
        ;;
    clear_logs | clean_logs)
        clear_logs_service
        ;;
    *)
        log Error "$0 $1 usage: $0 {start|stop|restart|status|logs_size|clear_logs}"
        exit 1
        ;;
esac
