#!/system/bin/sh

# Unified environment initialization for all mono-box scripts.
# Source this file as the first action in any script that needs
# the box runtime environment.

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH:/data/data/com.termux/files/usr/bin"

if [ -z "${scripts_dir}" ]; then
    scripts=$(realpath "$0")
    scripts_dir=$(dirname "${scripts}")
fi

. "${scripts_dir}/box.config"

bin_name="${bin_name:-mihomo}"
CORE_USER_GROUP="${CORE_USER_GROUP:-root:net_admin}"
box_path="${box_path:-/data/adb/box}"
bin_path="${bin_path:-${box_path}/bin/${bin_name}}"
run_path="${run_path:-${box_path}/run}"
pid_file="${pid_file:-${run_path}/${bin_name}.pid}"
clash_api_port="${clash_api_port:-9090}"

service_path="${scripts_dir}/box.service"
run_log="${run_path}/run.log"

module_dir="/data/adb/modules/mono_box"
[ -n "$(magisk -v 2>/dev/null | grep lite)" ] && module_dir=/data/adb/lite_modules/mono_box

. "${scripts_dir}/box.utils"
