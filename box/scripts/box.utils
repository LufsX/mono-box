#!/system/bin/sh

ssid() {
    if connected; then
        local ssid_name
        ssid_name=$(dumpsys wifi | grep mWifiInfo | head -n 1 | cut -d '"' -f 2)
        if [ -n "$(printf '%s' "${ssid_name}" | grep '<unknown ssid>')" ]; then
            printf '%s' '<unknown ssid>'
            return
        fi
        printf '%s' "${ssid_name}"
    else
        printf '%s' '<unknown ssid>'
        return 1
    fi
}

connected() {
    grep -q wlan /data/misc/net/rt_tables 2> /dev/null
}

api_request() {
    local method="$1"
    local path="$2"
    local data="$3"
    local clash_api_port="${clash_api_port:-9090}"
    local url="http://127.0.0.1:${clash_api_port}${path}"

    set -- -s -X "${method}" "${url}"

    if [ -n "${clash_api_secret}" ]; then
        set -- "$@" -H "Authorization: Bearer ${clash_api_secret}"
    fi

    if [ -n "${data}" ]; then
        set -- "$@" -H 'Content-Type: application/json' -d "${data}"
    fi

    curl "$@"
}

status() {
    api_request GET "/configs" > /dev/null 2>&1
    return $?
}

setOutbound() {
    [ -z "$1" ] || [ -z "$2" ] && return 1
    api_request PUT "/proxies/$1" "{\"name\": \"$2\"}"
}

setMode() {
    [ -z "$1" ] && return 1
    api_request PATCH "/configs" "{\"mode\": \"$1\"}"
}

getTarget() {
    local mapping="$1"
    local key="$2"
    printf '%s' "${mapping}" | tr ';' '\n' | awk -F ',' -v target="${key}" '$1==target {print $2; exit}'
}

getKeyValue() {
    [ -z "$1" ] && return 1
    local key="$1"
    read -r line
    printf '%s' "$line" | grep -E -o '"'${key}'" *: *[0-9]*|"'${key}'" *: *"[^"]+"|"'${key}'" *: *true|"'${key}'" *: *false|"'${key}'" *: *null' | awk -F '(: ?)' '{gsub(/^"|"$/, "", $2); print $2}'
}

getNowOutbound() {
    api_request GET "/proxies/${select_outbound}" 2> /dev/null | getKeyValue now
}

getNowMode() {
    api_request GET "/configs" 2> /dev/null | getKeyValue mode
}

setTun() {
    [ -z "$1" ] && return 1
    api_request PATCH "/configs" "{\"tun\": {\"enable\": ${1}}}"
}

getConfigs() {
    api_request GET "/configs"
}

upgradeCore() {
    api_request POST "/upgrade" "{}"
}
