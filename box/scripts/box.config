#!/system/bin/sh

# mono-box runtime configuration
# Notes:
# 1) Keep variable names unchanged for script compatibility.
# 2) Values below are defaults and can be adjusted as needed.

############################
# Core Runtime
############################

# Core binary name (current project is pure mihomo mode)
bin_name="mihomo"

# User:group used to run the core process
CORE_USER_GROUP="root:net_admin"

############################
# Paths (normally no need to edit)
############################

box_path="/data/adb/box"
bin_path="${box_path}/bin/${bin_name}"
run_path="${box_path}/run"
pid_file="${run_path}/${bin_name}.pid"

############################
# Clash API
############################

# Clash API port
clash_api_port=9090

# Clash API secret, keep empty if unused
clash_api_secret=

############################
# Action Toggle Behavior
############################

# toggle action type:
# service    -> start/stop service by current state (default)
# tun        -> switch tun state
# mode_cycle -> cycle clash mode by order list
toggle_action="service"

# valid when toggle_action=tun
# toggle / on / off
toggle_tun_target="toggle"

# valid when toggle_action=mode_cycle
# comma-separated mode order, valid values: rule,global,direct
# examples:
# "rule,global,direct"
# "rule,direct"
toggle_mode_cycle="rule,global,direct"

############################
# Network Event Control
############################

# Use SSID-based custom mapping for direct behavior
# true / false
use_custom_direct=false

# Control mode:
# disable  -> disable event-based control
# switch   -> switch core start/stop by Wi-Fi state
# tun      -> switch TUN by Wi-Fi state
# selector -> switch proxy group by Wi-Fi state
# mode     -> switch clash mode by Wi-Fi state
ctr_mode=disable

############################
# TUN Mode Settings
############################

# Default TUN state when on cellular network
# true / false / empty means no change
default_tun_enable="true"

# TUN state when on Wi-Fi
# true / false / empty means no change
direct_tun_enable="false"

# Optional TUN state override when on cellular
proxy_tun_enable=

# SSID-based mapping for Wi-Fi TUN state.
# Format: "SSID1,true;SSID2,false"
direct_tun_enable_list=""

############################
# Selector Mode Settings
############################

# Target selector policy group name in Clash API.
# Keep empty by default to avoid automatic selector changes.
select_outbound=""

# Default outbound when on cellular network
default_outbound=""

# Outbound when on Wi-Fi
direct_outbound=""

# Optional outbound override when on cellular
proxy_outbound=

# SSID-based mapping for Wi-Fi outbound.
# Format: "SSID1,OUTBOUND1;SSID2,OUTBOUND2"
# Example: "CMCC_XXXX,direct;TPLINK_XXXX,router"
direct_outbound_list=""

############################
# Clash Mode Settings
############################

# Default clash mode when on cellular network
default_clash_mode=""

# Clash mode when on Wi-Fi
direct_clash_mode=""

# Optional clash mode override when on cellular
proxy_clash_mode=

# SSID-based mapping for Wi-Fi clash mode.
# Format: "SSID1,MODE1;SSID2,MODE2"
# Example: "CMCC_XXXX,rule;TPLINK_XXXX,global"
direct_clash_mode_list=""
