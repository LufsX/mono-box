#!/system/bin/sh

############################
# Core Runtime
############################

# Mono Box runtime config. Paths are derived by scripts; edit only behavior.
bin_name="mihomo"
CORE_USER_GROUP="root:net_admin"

############################
# Clash API
############################

clash_api_port=9090
clash_api_secret=

############################
# Action Toggle Behavior
############################

# action.sh toggle behavior: service | tun | mode_cycle
toggle_action="service"
toggle_tun_target="toggle" # toggle | on | off
toggle_mode_cycle="rule,global,direct"

############################
# Network Event Control
############################

# Network event control: disable | switch | tun | selector | mode
ctr_mode=disable

############################
# Network Event Targets
############################

# Generic targets for ctr_mode=switch/tun/selector/mode.
# switch: start/stop; tun: true/false; selector: outbound name; mode: rule/global/direct.
select_outbound=""
target_cellular=""
target_wifi=""

# Format: "SSID,target;SSID,target"
target_wifi_list=""
