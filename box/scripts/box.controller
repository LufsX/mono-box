#!/system/bin/sh

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"
module_dir=/data/adb/modules/mono_box
lite_dir=/data/adb/lite_modules/mono_box
if [ -x "$lite_dir/bin/monobox" ]; then
    if [ ! -x "$module_dir/bin/monobox" ] || magisk -v 2>/dev/null | grep -q lite; then
        module_dir="$lite_dir"
    fi
fi
exec "$module_dir/bin/monobox" --module-dir "$module_dir" controller "$@"
